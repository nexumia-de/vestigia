  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <name>Travel Log</name>
  <summary>Location history and tracking for Dawarich</summary>
  <description>
    <p>
      Travel Log works with your own Dawarich server, on a Phosh phone
      and on the desktop. It will show where you have been on a map and
      record your phone's position for your server.
    </p>
    <p>
      This first version is only the empty app; connecting to a server
      comes next.
    </p>
    <p>
      Travel Log is an independent project and not affiliated with
      Dawarich. Your location data goes only to the server you configure.
    </p>
  </description>
  <developer id="de.nexumia">
